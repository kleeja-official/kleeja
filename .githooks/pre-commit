#!/bin/sh
# Checks that staged files are formatted with prettier.

if [ ! -d "node_modules/prettier" ]; then
    echo "Warning: prettier is not installed. Run 'npm install'. Skipping format check."
    exit 0
fi

# Only the files staged for this commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "Checking code formatting..."

# --ignore-unknown skips binaries and any extension prettier has no parser for;
# .prettierignore still applies, so vendored assets and templates are excluded.
echo "$STAGED_FILES" | xargs npx prettier --check --ignore-unknown

if [ $? -ne 0 ]; then
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║                Code Formatting Check Failed!                ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo "Please format your code before committing."
    echo "Run: npm run format"
    echo ""
    exit 1
fi

exit 0
